{
  "name": "jadoo",
  "version": "1.0.0",
  "private": true,
  "description": "Jadoo \u2014 batch video logo overlay desktop app (Tauri 2 + Next.js)",
  "author": "Zaheer Ahmad",
  "homepage": "https://jadoo.bond",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 1420",
    "build": "next build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "prepare:ffmpeg": "node scripts/fetch-ffmpeg.mjs && node scripts/prepare-ffmpeg.mjs",
    "app:icon": "tauri icon",
    "app:dev": "npm run prepare:ffmpeg && tauri dev",
    "app:build": "npm run prepare:ffmpeg && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "typescript": "^7.0.2"
  }
}
