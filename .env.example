# Is file ko `.env` naam se copy karo (`.env` gitignored hai, kabhi commit
# nahi hoti) aur apni asal values daal do. Ye sirf LOCAL `pnpm app:build` ke
# liye chahiye — GitHub Actions apne Secrets se alag se leta hai, isse nahi.
#
# Jo private key `pnpm tauri signer generate` ne banayi thi uska PATH yahan
# daal do (raw content paste karne ki zaroorat nahi — Tauri path aur content
# dono accept karta hai, path simple hai):
TAURI_SIGNING_PRIVATE_KEY=C:/Users/XeeBee/.tauri/jadoo.key

# Jo password key generate karte waqt set kiya tha (khali chhoda tha to
# ye line khali hi rehne do):
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
